<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Edit menu keeps what a text field genuinely needs and loses
	     the rest. Dictation sends what is typed to a speech service and
	     the character palette is for composing prose; neither belongs
	     beside a PIN, a PUK or a card access number, and a menu item
	     that must never be used is better absent than present. -->
	<key>NSDisabledDictationMenuItem</key>
	<true/>
	<key>NSDisabledCharacterPaletteMenuItem</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Public-key infrastructure is fetched over plain HTTP, by
		     design and by specification: RFC 6960 defines OCSP over
		     HTTP, RFC 3161 defines timestamping over HTTP, and the
		     caIssuers and OCSP addresses this app fetches are written
		     inside third-party certificates, so they cannot be
		     enumerated here as exception domains.

		     Transport security would add nothing to any of them. Every
		     response is a signed object that this app verifies on its
		     own terms - a timestamp token is checked against the digest
		     and nonce it was asked for, a certificate is checked by
		     what signs it - and requiring TLS first would be circular,
		     since validating a TLS certificate is itself an OCSP fetch.

		     What bounds the exposure is the code rather than this key:
		     the app makes exactly two kinds of request, to addresses
		     that are either configured in Settings or named inside a
		     certificate it is already validating. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fi</string>
		<string>sv</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NFCReaderUsageDescription</key>
	<string>ReFineID reads your identity card over NFC to sign you in.</string>
	<key>NSCameraUsageDescription</key>
	<string>ReFineID reads the access number printed on your card so you do not have to type it.</string>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A000000063504B43532D3135</string>
		<string>A0000000181002030000000000000000</string>
		<string>A000000018434D00</string>
		<string>A000000151000000</string>
		<string>A0000002471001</string>
		<string>A000000308000010000100</string>
	</array>
</dict>
</plist>
