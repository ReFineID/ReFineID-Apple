<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS only; the macOS build uses ReFineID-Info.plist.

	     Document signing follows certificate-declared RFC 3161, OCSP,
	     and CRL endpoints. Some public PKI endpoints still use HTTP,
	     so ATS permits those fetches. SigningNetwork remains the
	     enforcement boundary: it accepts only HTTP(S), rejects local
	     and private destinations, pins resolved public addresses,
	     bounds redirects and response sizes, and cryptographically
	     verifies every fetched artifact before use. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>fi</string>
		<string>sv</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NFCReaderUsageDescription</key>
	<string>ReFineID reads your identity card over NFC for authentication, document signing, activation, and PIN management.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>ReFineID reads the access number printed on your card so you do not have to type it.</string>
	<!-- Press and hold the icon to run the setup flow against a test
	     person instead of a card, for someone who has no Finnish
	     identity card to present. Declared here rather than registered
	     at runtime so it is on the icon before the app has ever been
	     launched. The title is the key its translations are looked up
	     under in Sources/App/InfoPlist.xcstrings; the type is what
	     DemoModeShortcut matches. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>eyeglasses</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Demo Mode</string>
			<key>UIApplicationShortcutItemType</key>
			<string>fi.refineid.shortcut.demonstration</string>
		</dict>
	</array>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A000000063504B43532D3135</string>
		<string>A0000000181002030000000000000000</string>
		<string>A000000018434D00</string>
		<string>A000000151000000</string>
		<string>A0000002471001</string>
		<string>A000000308000010000100</string>
	</array>
</dict>
</plist>
