<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The CryptoTokenKit extension is sandboxed and needs smart-card
     access; nothing else. The application-group grant returns with
     contactless card reading (FEATURE_CONTACTLESS), which the MVP
     does not ship - see Config/Features.xcconfig. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.smartcard</key>
	<true/>
</dict>
</plist>
