<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The CryptoTokenKit extension is sandboxed and needs smart-card
     access, and nothing else. It carries no network grant: signing a
     digest for Safari asks no endpoint, and the iPhone credential
     relay that would need one ships compile-gated off by
     FEATURE_IPHONE_RELAY - see Config/Features.xcconfig. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.smartcard</key>
	<true/>
</dict>
</plist>
