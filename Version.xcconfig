// The version of ReFineID, in the one place that defines it.
//
// Apple splits a release into two numbers with different jobs, and both
// are build settings -- which default to per target, per configuration.
// Left in the project file they became the same value written twenty-four
// times, so every release rewrote twenty-four lines and dirtied a file
// that a release is supposed to never touch. They live here instead, and
// the project's build configurations inherit them.
//
//   MARKETING_VERSION (CFBundleShortVersionString) = YY.M.D
//       What a person reads. The release date, no zero padding.
//
//   CURRENT_PROJECT_VERSION (CFBundleVersion) = H * 10 + M / 10
//       What App Store Connect orders builds by. The ten-minute bucket
//       of UTC the build was cut in, so two builds on one day always
//       increase. UTC, not local time: local time repeats an hour at
//       the autumn daylight-saving fall-back, which could make a build
//       number collide or go backwards, and it depends on the build
//       machine's zone. UTC has neither problem.
//
// Scripts/stamp-version.sh rewrites the two settings below and nothing
// else. The Swift release manager's candidate command overrides both on the
// xcodebuild command line, which wins over this file, so a release never edits it.

#include "Config/Features.xcconfig"

// The Apple Team the app and its extensions sign under, in one place
// rather than repeated in every target's build settings. It is a
// public identifier - it is stamped into every signed binary - so it
// belongs here where a fork changes it once.
// The oldest systems the app runs on, in one place rather than repeated
// in every target. iOS 16 is what an iPad 5th generation reaches, and that
// iPad is a useful requester: it has no antenna and never reads a card
// itself, but it pairs with a phone that does and serves the browser the
// certificate that phone answers for. Nothing newer is required for that
// path -- CryptoTokenKit has published identities since iOS 14 and the RAPP
// engine needs only CryptoKit, from iOS 13.
//
// Anything newer the app uses is either behind an availability check or
// behind REFINEID_LOCAL_CARD in Config/Features.xcconfig.
IPHONEOS_DEPLOYMENT_TARGET = 16.0

// What the store artifact demands is a different question from what the
// tree can build. The shipping configurations require iOS 26, and iPhone
// alone: every feature the first release carries needs the NFC smart-card
// slot, which arrived in iOS 26 and exists on no iPad, and no iPadOS 26
// device is available to qualify the requester path an iPad would run.
// Debug and Profile keep the wider floor and both families, so the
// iPad-requester experiment stays cheap to resume when the remote card
// returns. The archive inspector holds a candidate to these numbers, so
// a wrongly cut artifact fails before it is uploaded.
IPHONEOS_DEPLOYMENT_TARGET[config=TestFlight] = 26.0
IPHONEOS_DEPLOYMENT_TARGET[config=Release] = 26.0

// The same fact as a compilation condition, for the handful of app and
// extension sources that must compile at both floors: a check like
// `#available(iOS 17, *)` is required at floor 16 and refused as an
// unnecessary check at floor 26, so those sites branch on this instead.
// Defined beside the floor so the two can never disagree. The CardCore
// package builds at its own manifest floor and never needs it.
REFINEID_IOS_FLOOR_FEATURE =
REFINEID_IOS_FLOOR_FEATURE[config=TestFlight] = REFINEID_IOS_FLOOR_26
REFINEID_IOS_FLOOR_FEATURE[config=Release] = REFINEID_IOS_FLOOR_26

TARGETED_DEVICE_FAMILY = 1,2
TARGETED_DEVICE_FAMILY[config=TestFlight] = 1
TARGETED_DEVICE_FAMILY[config=Release] = 1

DEVELOPMENT_TEAM = 4ZJC3SFJR2

MARKETING_VERSION = 26.8.23
CURRENT_PROJECT_VERSION = 125
