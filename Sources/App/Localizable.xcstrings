        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelringen nekade rensningen av loggarna (%lld)."
          }
        }
      }
    },
    "The new entries differ.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudet syötteet eroavat toisistaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De nya inmatningarna skiljer sig åt."
          }
        }
      }
    },
    "The portrait forms a signed QR stamp carrying the document name and signing time.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasvokuvasta muodostuu allekirjoitettu QR-leima, jossa on asiakirjan nimi ja allekirjoitusaika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Porträttet bildar en signerad QR-stämpel med dokumentets namn och signeringstid."
          }
        }
      }
    },
    "The signature image could not be read.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimikirjoituskuvaa ei voitu lukea."
