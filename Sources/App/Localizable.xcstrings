    "That card access number was refused.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin käyttönumeroa ei hyväksytty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortets åtkomstnummer avvisades."
          }
        }
      }
    },
    "The card checks the %@ first, and a wrong entry spends one attempt. Exhausting the %@ cannot be undone by any software.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The card checks the %1$@ first, and a wrong entry spends one attempt. Exhausting the %2$@ cannot be undone by any software."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortti tarkistaa ensin koodin %@, ja väärä syöte kuluttaa yhden yrityksen. Kun %@ on kulutettu loppuun, sitä ei palauta mikään ohjelmisto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortet kontrollerar %@ först, och en felaktig inmatning förbrukar ett försök. När %@ är förbrukad kan ingen programvara återställa den."
          }
        }
      }
    },
    "The card checks the current %@ first, and a wrong entry spends one attempt.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortti tarkistaa ensin nykyisen koodin %@, ja väärä syöte kuluttaa yhden yrityksen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortet kontrollerar nuvarande %@ först, och en felaktig inmatning förbrukar ett försök."
          }
        }
      }
    },
    "The card could not be read. Hold it still and try again.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korttia ei voitu lukea. Pidä se paikallaan ja yritä uudelleen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortet kunde inte läsas. Håll det stilla och försök igen."
          }
        }
      }
    },
    "The card details could not be stored on this iPhone.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin tietoja ei voitu tallentaa tähän iPhoneen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortets uppgifter kunde inte sparas på den här iPhone."
          }
        }
      }
    },
    "The card details were stored, but Safari setup did not finish. Try priming the card again.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin tiedot tallennettiin, mutta Safari-määritys jäi kesken. Yritä kortin käyttöönottoa uudelleen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortets uppgifter sparades, men Safari-konfigurationen slutfördes inte. Försök läsa in kortet igen."
          }
        }
      }
    },
    "The card did not return a usable certificate.": {
      "localizations": {
        "fi": {
          "stringUnit": {
