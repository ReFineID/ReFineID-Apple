    "That card access number was refused.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin käyttönumeroa ei hyväksytty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortets åtkomstnummer avvisades."
          }
        }
      }
    },
    "The card checks the %@ first, and a wrong entry spends one attempt. Exhausting the %@ cannot be undone by any software.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The card checks the %1$@ first, and a wrong entry spends one attempt. Exhausting the %2$@ cannot be undone by any software."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortti tarkistaa ensin koodin %@, ja väärä syöte kuluttaa yhden yrityksen. Kun %@ on kulutettu loppuun, sitä ei palauta mikään ohjelmisto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortet kontrollerar %@ först, och en felaktig inmatning förbrukar ett försök. När %@ är förbrukad kan ingen programvara återställa den."
          }
        }
      }
    },
    "The card checks the current %@ first, and a wrong entry spends one attempt.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortti tarkistaa ensin nykyisen koodin %@, ja väärä syöte kuluttaa yhden yrityksen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortet kontrollerar nuvarande %@ först, och en felaktig inmatning förbrukar ett försök."
          }
        }
      }
    },
    "The card is in use by another app - try again": {
      "extractionState": "stale",
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortti on toisen sovelluksen käytössä - yritä uudelleen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortet används av en annan app - försök igen"
          }
        }
      }
    },
    "The card's handwritten signature appears on a line, with its certificate name and SATU below.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin nimikirjoitus näkyy viivalla, ja sen alla varmenteen nimi ja SATU."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortets namnteckning visas på en linje, med certifikatets namn och SATU under."
          }
        }
      }
    },
    "The certificate identity could not be read.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmenteen identiteettiä ei voitu lukea."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikatets identitet kunde inte läsas."
          }
        }
      }
    },
    "The entry from the issuance letter works once, and this sets both PIN 1 and PIN 2 to the values typed above.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myöntökirjeen koodi toimii kerran, ja tämä asettaa sekä PIN 1:n että PIN 2:n yllä kirjoitettuihin arvoihin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden från utfärdandebrevet fungerar en gång, och detta ställer in både PIN 1 och PIN 2 till värdena som skrivits ovan."
          }
        }
      }
    },
    "The handwritten signature could not be read; no visible stamp was added.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimikirjoitusta ei voitu lukea; näkyvää leimaa ei lisätty."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnteckningen kunde inte läsas; ingen synlig stämpel lades till."
          }
        }
      }
    },
    "The keychain refused to clear the logs (%lld).": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avainnippu esti lokien tyhjentämisen (%lld)."
