            "state": "translated",
            "value": "De nya inmatningarna skiljer sig åt."
          }
        }
      }
    },
    "The phone's card reader is busy. Try again in a moment.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelimen kortinlukija on varattu. Yritä hetken kuluttua uudelleen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonens kortläsare är upptagen. Försök igen om en stund."
