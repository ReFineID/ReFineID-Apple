        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortets namnteckning visas på en linje, med certifikatets namn och SATU under."
          }
        }
      }
    },
    "The certificate identity could not be read.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmenteen identiteettiä ei voitu lukea."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifikatets identitet kunde inte läsas."
          }
        }
      }
    },
    "The entry from the issuance letter works once, and this sets both PIN 1 and PIN 2 to the values typed above.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myöntökirjeen koodi toimii kerran, ja tämä asettaa sekä PIN 1:n että PIN 2:n yllä kirjoitettuihin arvoihin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden från utfärdandebrevet fungerar en gång, och detta ställer in både PIN 1 och PIN 2 till värdena som skrivits ovan."
          }
        }
      }
    },
    "The handwritten signature could not be read; no visible stamp was added.": {
      "localizations": {
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimikirjoitusta ei voitu lukea; näkyvää leimaa ei lisätty."
