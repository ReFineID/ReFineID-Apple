# Refuses any commit while the lint gate fails. The gate is Scripts/lint.sh,
# not a freehand swiftlint one-liner.
#
# Activate once per clone:
#   git config core.hooksPath Scripts/githooks

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
Scripts/lint.sh
